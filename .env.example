# ── 应用 ──────────────────────────────────────────────
APP_NAME=对镜
ENV=dev
DEBUG=false
TZ=Asia/Shanghai

# ── 数据库 ────────────────────────────────────────────
# 留空则使用 <项目根>/data/duijing.db
DB_PATH=

# ── 认证 ──────────────────────────────────────────────
# 必填。生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7
# 生产环境走 HTTPS，必须设为 true
COOKIE_SECURE=true
# 若前后端不同域，填你的域名，如 .example.com
COOKIE_DOMAIN=

# ── 注册 ──────────────────────────────────────────────
# 固定的邀请码，便于自己人加入。留空表示只用库内邀请码。
BOOTSTRAP_INVITE_CODE=
# 是否允许无邀请码自由注册（默认关闭）
ALLOW_OPEN_REGISTER=false

# ── CORS ──────────────────────────────────────────────
# 生产环境填前端域名，不要用 *
CORS_ORIGINS=https://your-domain.com

# ── AI ────────────────────────────────────────────────
# mock | deepseek | mimo | hybrid
#   mock     —— 不联网，全链路可跑，用于开发和演示
#   hybrid   —— 按方案 5.3 分流：辩论房走 DeepSeek，其余走 MiMo（推荐生产使用）
AI_PROVIDER=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

AI_TIMEOUT_SECONDS=120

# ── 限流 ──────────────────────────────────────────────
DEBATE_RATE_PER_MIN=10
AI_RATE_PER_MIN=6
LOGIN_RATE_PER_MIN=10

# ── 归档规则 ──────────────────────────────────────────
WEAKNESS_DELETE_DAYS=60
ADVANTAGE_ARCHIVE_DAYS=30
OBSERVATION_TTL_HOURS=24

# ── 辩论规则 ──────────────────────────────────────────
DEBATE_MIN_ROUNDS=4
DEBATE_MAX_ROUNDS=8
DEBATE_MESSAGE_MAX_CHARS=300
DEBATE_MAX_PARTICIPANTS=4

# ── 定时任务 ──────────────────────────────────────────
ENABLE_SCHEDULER=true
SCAN_CRON_DAY=sun
SCAN_CRON_HOUR=2
